# Copy to backend/.env and fill in. Never commit the real .env.

# --- model routing ---
MODEL_GATEWAY=fireworks_direct        # or: braintrust_proxy
FIREWORKS_API_KEY=fw_...
BRAINTRUST_API_KEY=

# --- braintrust scoreboard ---
BRAINTRUST_PROJECT=morph
BRAINTRUST_PROJECT_ID=                # from the Braintrust project URL — powers BTQL scoreboard

# --- daytona ---
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=morph-node20         # prebuilt node20 + npm deps snapshot

# --- github (Daytona pushes winning morphs here) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_USER=morph-bot

# --- elevenlabs voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- app-under-edit build/serve (inside the sandbox) ---
APP_SUBDIR=frontend
BUILD_CMD=npm run build
DEV_CMD=npm run dev -- --host 0.0.0.0 --port 3000
DEV_PORT=3000
UNDO_WINDOW_S=15
