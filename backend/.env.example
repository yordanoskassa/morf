# Copy to backend/.env and fill in. Never commit the real .env.
# NOTE: keep comments on their OWN lines. An inline comment after an EMPTY value
# (e.g. `KEY=   # note`) gets captured as the value by python-dotenv.

# --- model routing ---
# fireworks_direct | braintrust_proxy
MODEL_GATEWAY=fireworks_direct
FIREWORKS_API_KEY=fw_...
BRAINTRUST_API_KEY=

# --- braintrust scoreboard ---
BRAINTRUST_PROJECT=morph
# project id from the Braintrust project URL (or GET /v1/project?project_name=morph)
BRAINTRUST_PROJECT_ID=

# --- daytona ---
DAYTONA_API_KEY=
# image (no setup, default) | snapshot (warm, prebuilt)
DAYTONA_MODE=image
DAYTONA_IMAGE=node:20-bookworm
DAYTONA_SNAPSHOT=morph-node20

# --- github (Daytona clones this to build, and pushes winning morphs here) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_USER=morph-bot

# --- elevenlabs voice (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- mongodb (consistent store: morphs, history, undo, scoreboard) ---
MONGODB_URI=
MONGODB_DB=morph

# --- app-under-edit build/serve (inside the sandbox) ---
APP_SUBDIR=frontend
INSTALL_CMD=npm install --no-audit --no-fund
BUILD_CMD=npm run build
DEV_CMD=npm run dev -- --host 0.0.0.0 --port 3000
DEV_PORT=3000
UNDO_WINDOW_S=15
